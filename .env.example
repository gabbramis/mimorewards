# Landing page: set these values before publishing, then rebuild.
# The contact form opens a prepared email in the visitor's mail application.
# It does not submit to a database or claim a registration was saved.
NEXT_PUBLIC_MIMO_CONTACT_EMAIL=
NEXT_PUBLIC_MIMO_SITE_URL=http://localhost:3000

# Optional fallback while NFC stands are not yet loaded into nfc_tags.
MIMO_DEFAULT_BUSINESS_ID=ea6ae0d6-c8db-4b15-a09d-9726f93b7119
MIMO_NFC_DIRECTORY_ENABLED=false

# Keep your existing Supabase configuration in .env.local.
# Server-only: required by the protected stamp RPC. Never expose this as NEXT_PUBLIC_ or in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional; if omitted, the service role key signs customer sessions server-side.
MIMO_CUSTOMER_SESSION_SECRET=
# Server-only: shared secret for internal mimo <-> n8n automation endpoints
# (/api/internal/automations/*). n8n sends it as `x-mimo-automation-key`.
# Never expose this as NEXT_PUBLIC_ or in the browser.
MIMO_AUTOMATION_SECRET=

# Apple Wallet: in production, set these three server-only values to the base64
# contents of signerCert.pem, mimo-wallet-private-key.pem, and wwdrg4.pem.
# Locally, the ignored .secrets/apple-wallet files are used instead.
APPLE_WALLET_SIGNER_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_WWDR_CERT_BASE64=

# Google Wallet: server-only configuration.
# GOOGLE_WALLET_ISSUER_ID is obtained from Google Pay & Wallet Console.
# For credentials, you can provide google-service-account.json in the project root,
# or set GOOGLE_WALLET_CLIENT_EMAIL and GOOGLE_WALLET_PRIVATE_KEY.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
